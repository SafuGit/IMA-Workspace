# --- Google Sheets / SponsorRadar Brand Import ---
# The spreadsheet ID from the URL (between /d/ and /edit)
SPONSORRADAR_SHEET_ID=
# Optional: tab name (defaults to first tab if blank)
SPONSORRADAR_SHEET_NAME=

# Option A – Service Account JSON (recommended for automation)
# Set to the file path of your service account key JSON, OR paste the raw JSON string:
GOOGLE_SERVICE_ACCOUNT_JSON=

# Option B – OAuth / user credentials (dev only, opens browser on first run)
GOOGLE_OAUTH_CREDENTIALS_FILE=
